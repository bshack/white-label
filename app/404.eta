<!DOCTYPE html>
<html lang="en-US" dir="ltr">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex,follow">
        <title>Page not found | Gold North</title>
        <link rel="stylesheet" href="<%= it.cdn %>release/<%= it.version %>/assets/style/global.css">
    </head>
    <body>
        <a class="skip-link" href="#main">Skip to the message</a>
        <main id="main" tabindex="-1" class="container section">
            <h1>Page not found</h1>
            <p>The requested page does not exist.</p>
            <p><a href="<%= it.www %>">Return to the Gold North history</a></p>
        </main>
    </body>
</html>
