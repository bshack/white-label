{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "outDir": "dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": [
      "node",
      "react"
    ],
    "noEmitOnError": true
  },
  "include": [
    "scripts/**/*.ts",
    "app/assets/script/**/*.ts",
    "app/assets/script/**/*.tsx"
  ]
}
