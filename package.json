{
  "name": "generator-white-label",
  "version": "5.0.1",
  "description": "Scaffolding for developing and building static sites.",
  "type": "module",
  "main": "dist/generators/app/index.js",
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "npm": ">=10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/scripts/build.js",
    "test": "npm run compile && npm run test:types && npm run test:unit",
    "audit": "npm audit --audit-level=low",
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test test/*.test.js",
    "coverage": "npm run compile && npm run test:types && c8 npm run test:unit",
    "prepack": "npm run compile",
    "test:types": "tsc -p tsconfig.consumer.json"
  },
  "files": [
    "app",
    "generators",
    "scripts",
    "README.md",
    "dist",
    "tsconfig.site.json"
  ],
  "keywords": [
    "handlebars",
    "sass",
    "esbuild",
    "yeoman-generator"
  ],
  "author": "Bill Shackelford",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bshack/white-label.git"
  },
  "bugs": {
    "url": "https://github.com/bshack/white-label/issues"
  },
  "homepage": "https://github.com/bshack/white-label",
  "dependencies": {
    "@types/node": "24.13.3",
    "@yeoman/adapter": "5.0.0",
    "bootstrap": "5.3.8",
    "chalk": "6.0.0",
    "esbuild": "0.28.2",
    "events": "3.3.0",
    "handlebars": "4.7.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "1.104.0",
    "white-label-model": "3.0.0",
    "white-label-view": "4.0.0",
    "yeoman-generator": "8.3.1",
    "yosay": "3.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/yosay": "2.0.3",
    "c8": "12.0.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "yeoman-environment": "7.0.0"
  },
  "types": "dist/generators/app/index.d.ts",
  "c8": {
    "all": true,
    "include": [
      "scripts/**/*.ts",
      "generators/**/*.ts",
      "app/assets/script/**/*.ts",
      "app/assets/script/**/*.tsx"
    ],
    "reporter": [
      "text",
      "json",
      "json-summary",
      "lcov"
    ],
    "excludeAfterRemap": true,
    "checkCoverage": true,
    "lines": 100,
    "functions": 100,
    "branches": 100,
    "statements": 100,
    "perFile": true,
    "exclude": [
      "**/*.d.ts"
    ]
  }
}
