{
  "name": "generator-white-label",
  "version": "10.0.3",
  "description": "Framework-independent TypeScript project generator for accessible, SEO-friendly, HTML-first sites with progressive enhancement, tagged HTML templates, and provider-neutral serverless composition.",
  "type": "module",
  "main": "dist/scaffold/index.js",
  "bin": {
    "generator-white-label": "dist/cli/index.js",
    "white-label": "dist/cli/index.js"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "node --run compile && node dist/scripts/build.js",
    "test": "node --run compile && node --run test:types && node --run test:unit",
    "audit": "npm audit --audit-level=low",
    "compile": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test test/*.test.js",
    "coverage": "node --run compile && node --run test:types && c8 node --run test:unit",
    "prepack": "node --run compile",
    "test:types": "tsc -p tsconfig.consumer.json",
    "lint": "eslint \"cli/**/*.ts\" \"scripts/**/*.ts\" \"scaffold/**/*.ts\" \"server/**/*.ts\" \"app/**/*.ts\" --max-warnings=0",
    "lint:fix": "node --run lint -- --fix"
  },
  "files": [
    ".editorconfig",
    ".yarnrc.yml",
    "pnpm-workspace.yaml",
    "app",
    "cli",
    "scaffold",
    "server",
    "scripts",
    "template-test",
    "README.md",
    "CLI.md",
    "PACKAGE_MANAGERS.md",
    "EXISTING_APPLICATIONS.md",
    "dist",
    "tsconfig.site.json"
  ],
  "keywords": [
    "typescript",
    "project-generator",
    "static-site-generator",
    "static-site",
    "web-development",
    "framework-independent",
    "html-first",
    "html-template",
    "tagged-template",
    "accessibility",
    "seo",
    "seo-friendly",
    "progressive-enhancement",
    "serverless",
    "web-standards",
    "esbuild",
    "cli",
    "scaffolding",
    "white-label"
  ],
  "author": "Bill Shackelford",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bshack/white-label.git"
  },
  "bugs": {
    "url": "https://github.com/bshack/white-label/issues"
  },
  "homepage": "https://whitelabeljs.org/docs/generator/",
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@babel/eslint-parser": "8.0.5",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.13.3",
    "axe-core": "4.13.0",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "html-validate": "11.15.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "white-label-mediator": "5.0.1",
    "white-label-model": "7.0.3",
    "white-label-router": "6.1.2",
    "white-label-view": "7.0.2"
  },
  "types": "dist/scaffold/index.d.ts",
  "c8": {
    "all": true,
    "include": [
      "cli/**/*.ts",
      "scripts/**/*.ts",
      "scaffold/**/*.ts",
      "server/**/*.ts",
      "app/**/*.ts"
    ],
    "reporter": [
      "text",
      "json",
      "json-summary",
      "lcov"
    ],
    "excludeAfterRemap": true,
    "checkCoverage": true,
    "lines": 100,
    "functions": 100,
    "branches": 100,
    "statements": 100,
    "perFile": true,
    "exclude": [
      "**/*.d.ts",
      "app/assets/view/page-data.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/scaffold/index.d.ts",
      "import": "./dist/scaffold/index.js",
      "default": "./dist/scaffold/index.js"
    },
    "./scaffold": {
      "types": "./dist/scaffold/index.d.ts",
      "import": "./dist/scaffold/index.js",
      "default": "./dist/scaffold/index.js"
    }
  }
}
