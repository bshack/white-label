{
  "name": "generator-white-label",
  "version": "7.0.0",
  "description": "A production-oriented static TypeScript site generator with accessible HTML, SEO output, and White Label integration.",
  "type": "module",
  "main": "dist/generators/app/index.js",
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "npm": ">=11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/scripts/build.js",
    "test": "npm run compile && npm run test:types && npm run test:unit",
    "audit": "npm audit --audit-level=low",
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test test/*.test.js",
    "coverage": "npm run compile && npm run test:types && c8 npm run test:unit",
    "prepack": "npm run compile",
    "test:types": "tsc -p tsconfig.consumer.json",
    "lint": "eslint \"scripts/**/*.ts\" \"generators/**/*.ts\" \"app/assets/script/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:fix": "npm run lint -- --fix"
  },
  "files": [
    "app",
    "generators",
    "scripts",
    "template-test",
    "README.md",
    "dist",
    "tsconfig.site.json"
  ],
  "keywords": [
    "typescript",
    "static-site-generator",
    "accessibility",
    "seo",
    "progressive-enhancement",
    "esbuild",
    "yeoman-generator",
    "white-label"
  ],
  "author": "Bill Shackelford",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bshack/white-label.git"
  },
  "bugs": {
    "url": "https://github.com/bshack/white-label/issues"
  },
  "homepage": "https://github.com/bshack/white-label",
  "dependencies": {
    "chalk": "6.0.0",
    "yeoman-generator": "8.4.0",
    "yosay": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/yosay": "2.0.3",
    "axe-core": "4.13.0",
    "bootstrap": "5.3.8",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "eta": "4.6.0",
    "html-validate": "11.14.0",
    "jsdom": "30.0.1",
    "sass": "1.104.0",
    "typescript": "7.0.2",
    "white-label-mediator": "3.0.0",
    "white-label-model": "github:bshack/white-label-model#582bef8c70cc246b2cd76b34aeb472ea7fef2f90",
    "white-label-router": "4.0.0",
    "white-label-view": "4.0.0",
    "yeoman-environment": "7.0.0",
    "@babel/core": "8.0.5",
    "@babel/eslint-parser": "8.0.5",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0"
  },
  "types": "dist/generators/app/index.d.ts",
  "c8": {
    "all": true,
    "include": [
      "scripts/**/*.ts",
      "generators/**/*.ts",
      "app/assets/script/**/*.ts",
      "app/assets/script/**/*.tsx"
    ],
    "reporter": [
      "text",
      "json",
      "json-summary",
      "lcov"
    ],
    "excludeAfterRemap": true,
    "checkCoverage": true,
    "lines": 100,
    "functions": 100,
    "branches": 100,
    "statements": 100,
    "perFile": true,
    "exclude": [
      "**/*.d.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/generators/app/index.d.ts",
      "import": "./dist/generators/app/index.js",
      "default": "./dist/generators/app/index.js"
    }
  },
  "packageManager": "npm@11.19.1"
}
